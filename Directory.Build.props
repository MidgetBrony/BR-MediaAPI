<Project>
  <Import Project="Directory.Build.user.props" Condition="Exists('Directory.Build.user.props')" />
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == '' and '$(BOXROOM_GAME_PATH)' != ''">$(BOXROOM_GAME_PATH)</GamePath>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>
</Project>
